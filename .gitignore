# =========================================================
# Daybed - archivos ignorados por Git
# =========================================================
# Objetivo: mantener el repositorio limpio de secretos, bases locales,
# cachés, builds, archivos generados y respaldos temporales.

# -------------------------
# Sistema operativo
# -------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
.Trashes/
.Spotlight-V100/
.fseventsd/

# -------------------------
# Editores / IDE
# -------------------------
.idea/
*.swp
*.swo
*.swn
*.bak
*.tmp
*.temp
*.orig
*.rej
*~

# Mantener recomendaciones compartidas de VS Code, ignorar estado local.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# -------------------------
# Variables de entorno / secretos
# -------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials/
service-account*.json
*.local

# -------------------------
# Python / Django
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Bases locales y respaldos de BD
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3.bak*
*.sqlite3.pre-*
*.sqlite
*.sqlite.bak*
*.db
*.db-journal
*.db-shm
*.db-wal
*.db.bak*

# Archivos generados por Django en local
media/
staticfiles/
local_settings.py

# Empaquetado Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Tests / cobertura / calidad
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# uv
# El lockfile SÍ debe versionarse para instalaciones reproducibles.
!backend/uv.lock

# -------------------------
# Node / React / Vite
# -------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Builds y cachés frontend
dist/
dist-ssr/
build/
.vite/
.eslintcache
.parcel-cache/
.next/
out/
coverage/

# Lockfiles frontend
# package-lock.json se mantiene versionado para npm ci reproducible.
!frontend/package-lock.json

# -------------------------
# Logs y evidencia temporal
# -------------------------
logs/
*.log
incoming/
evidence/
artifacts/
reports/
exports/
tmp/
temp/
.cache/

# -------------------------
# Infraestructura local
# -------------------------
docker-compose.override.yml
.docker/

# -------------------------
# Archivos comprimidos / entregables locales
# -------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
